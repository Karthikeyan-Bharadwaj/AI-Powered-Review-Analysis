# Copy this file to backend/.env and fill in your own credentials.
# Never commit the real backend/.env file.
BESTBUY_API_KEY=your_bestbuy_api_key_here
MONGO_URI=your_mongodb_connection_string_here
SCRAPER_API_KEY=your_scraper_api_key_here

# Origin of the deployed frontend, used to restrict CORS in production
FRONTEND_ORIGIN=http://localhost:8080

# Set to "true" on memory-constrained hosts (e.g. Render free tier) to skip
# loading the local HuggingFace summarization model and use a lightweight
# extractive summary fallback instead.
NLP_DISABLE_SUMMARIZER=false
